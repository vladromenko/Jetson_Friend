[Unit]
Description=MILO voice assistant
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Jetson_Friend
ExecStart=%h/Jetson_Friend/start_milo.sh
ExecStop=%h/Jetson_Friend/stop_milo.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=default.target
