# Copy to config.env and set JETSON_FRIEND_ROOT to the checkout on the Jetson.
JETSON_FRIEND_ROOT=/home/vlad/Jetson_Friend
ASSISTANT_NAME=MILO
LLM_MODEL=$JETSON_FRIEND_ROOT/models/llm/Qwen3-4B-Q4_K_M.gguf
LLAMA_SERVER_BIN=$JETSON_FRIEND_ROOT/deps/llama.cpp/build/bin/llama-server
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081
LLAMA_CTX=2048
LLAMA_UBATCH=128
LLAMA_GPU_LAYERS=99
LLAMA_REASONING_BUDGET=0
LLM_MAX_TOKENS=96
LLM_STREAM=1
LLAMA_LOG_PATH=$JETSON_FRIEND_ROOT/data/llama-server.log
MILO_METRICS_PATH=$JETSON_FRIEND_ROOT/data/latency.jsonl
WHISPER_BIN=$JETSON_FRIEND_ROOT/deps/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=$JETSON_FRIEND_ROOT/models/whisper/ggml-base.en.bin
PIPER_BIN=$JETSON_FRIEND_ROOT/.venv/bin/piper
PIPER_VOICE=$JETSON_FRIEND_ROOT/models/tts/en_US-ryan-low.onnx
PIPER_PERSISTENT=1
OBJECT_MODEL=$JETSON_FRIEND_ROOT/models/vision/yolov8n.engine
FACE_MODEL=$JETSON_FRIEND_ROOT/models/vision/face_detection_yunet.engine
FACE_RECOGNITION_MODEL=$JETSON_FRIEND_ROOT/models/vision/face_recognition_sface.onnx
COCO_LABELS=$JETSON_FRIEND_ROOT/models/vision/coco.yaml
CAMERA_INDEX=0
AUDIO_INPUT_DEVICE=C920
# Device name selects a matching PipeWire sink when available, then ALSA.
# Use pipewire for the desktop default, or hw:/plughw: for explicit ALSA.
AUDIO_OUTPUT_DEVICE=UACDemo
MILO_VISUAL_EMOTION=0
VISION_FACE_ACTIVE_SEC=0.35
VISION_FACE_IDLE_SEC=1.2
BEHAVIOR_ABSENCE_CONFIRM_SEC=5
LONG_ABSENCE_HOURS=6
PROACTIVE_QUIET_SEC=60
# Optional visual reasoning loads only on an explicit visual question.
VLM_ENABLE=1
VLM_MODEL=$JETSON_FRIEND_ROOT/models/vlm/qwen2.5-vl-3b/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
VLM_MMPROJ=$JETSON_FRIEND_ROOT/models/vlm/qwen2.5-vl-3b/mmproj-Qwen2.5-VL-3B-Instruct-Q8_0.gguf
SETTINGS_HOST=127.0.0.1
SETTINGS_PORT=8765

# Arm-mounted DaBai: test posture, not measured/calibrated joint positions.
MILO_ARM_FACE_SEARCH_POSE=90,115,115,110,135,120
MILO_FACE_SEARCH_J1_MIN=45
MILO_FACE_SEARCH_J1_MAX=135
MILO_FACE_SEARCH_STEP_DEG=3
MILO_FACE_SEARCH_RUNTIME_MS=320
MILO_FACE_SEARCH_SETTLE_SEC=0.10
MILO_FACE_SEARCH_DIRECTION=1
MILO_FACE_SEARCH_CONFIRMATIONS=3
MILO_FACE_SEARCH_LOSS_TIMEOUT_SEC=2.5
MILO_ARM_READY_TIMEOUT_SEC=45
MILO_CAMERA_READY_TIMEOUT_SEC=45
MILO_FACE_SEARCH_POSE_RUNTIME_MS=5000
# Detector-only clockwise image rotation; independent of physical camera aim.
MILO_FACE_IMAGE_ROTATION_DEG=0
