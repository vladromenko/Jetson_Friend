# MILO Clean RC13 - Jetson Orin / ROS 2 Jazzy
ASSISTANT_NAME=MILO
ROS_DOMAIN_ID=30
APP_PYTHON="$ROOT/.venv/bin/python"

# One generated ROS workspace inside the canonical repository.
MICROROS_WS="$ROOT/ros_ws"
INTERFACES_WS="$ROOT/ros_ws"
ORBBEC_WS="$ROOT/ros_ws"
ARM_SERIAL=/dev/serial/by-id/usb-Silicon_Labs_CP2104_USB_to_UART_Bridge_Controller_02E0E664-if00-port0
ARM_BAUD=2000000

# Local Gemma multimodal server
LLAMA_SERVER_BIN="$ROOT/deps/llama.cpp/build/bin/llama-server"
LLM_MODEL="$ROOT/models/vlm/gemma4/gemma-4-E2B-it-Q4_0.gguf"
VLM_MMPROJ="$ROOT/models/vlm/gemma4/mmproj-gemma-4-E2B-it-Q8_0.gguf"
LLM_HOST=127.0.0.1
LLM_PORT=8081
LLM_CTX=4096
LLM_GPU_LAYERS=99
LLM_UBATCH=128
LLM_MAX_TOKENS=180
LLM_TIMEOUT_SEC=120

# Speech
WHISPER_BIN="$ROOT/deps/whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL="$ROOT/models/whisper/ggml-base.en.bin"
WHISPER_LANGUAGE=en
AUDIO_INPUT_HINT=UM02
AUDIO_OUTPUT_HINT=UACDemo
MIC_SAMPLE_RATE=44100
MIC_BLOCK_SIZE=1024
MIC_MAX_SECONDS=12
VAD_SPEECH_THRESHOLD=0.0020
VAD_SILENCE_THRESHOLD=0.0012
VAD_END_SILENCE_SEC=0.55
VAD_MIN_SPEECH_SEC=0.20
VAD_PRE_ROLL_SEC=0.20
WHISPER_MIN_AUDIO_RMS=0.0008
PIPER_BIN="$ROOT/.venv/bin/piper"
PIPER_VOICE="$ROOT/models/tts/en_US-ryan-low.onnx"

# Vision. Prefer the already-built TensorRT YuNet, then ONNX DNN, then Haar.
FACE_ENGINE="$ROOT/models/vision/face_detection_yunet.engine"
FACE_MODEL="$ROOT/models/vision/face_detection_yunet.onnx"
OBJECT_MEMORY_PATH="$ROOT/data/object_memory.json"
FACE_SCORE=0.55
CAMERA_COLOR_TOPIC=/camera/color/image_raw
CAMERA_DEPTH_TOPIC=/camera/depth/image_raw
CAMERA_MAX_AGE_SEC=1.0
FACE_SMOOTH_ALPHA=0.55
FACE_CONFIRM_FRAMES=2
FACE_MAX_WIDTH=0.70
FACE_MAX_HEIGHT=0.85

# Arm ROS
ARM_FEEDBACK_TOPIC=/arm6_feedback
ARM_RAW_TOPIC=/arm6_raw
ARM_COMMAND_TOPIC=/arm_joint
ARM_ALLOWED_JOINTS=1,3,4,5
ARM_RUNTIME_MS=250
ARM_MAX_STEP_DEG=9
ARM_MAX_SPEED_DEG_S=36
ARM_FEEDBACK_MAX_AGE_SEC=1.0
ARM_FEEDBACK_STABLE_SAMPLES=3
ARM_FEEDBACK_STABILITY_DEG=3
ARM_FEEDBACK_MAX_JUMP_DEG=12
ARM_FEEDBACK_SOFT_LIMIT_DEG=5

# After power loss servos can sag mechanically. Before face following starts,
# gently lift J2/J3 back to the verified assistant posture, then bring J4 to
# its verified screen-upright home. J6 is never commanded.
ARM_STARTUP_LIFT_ENABLED=1
ARM_STARTUP_J2_TARGET=115
ARM_STARTUP_J3_TARGET=75
ARM_STARTUP_J4_TARGET=0
ARM_STARTUP_STEP_DEG=4
ARM_STARTUP_RUNTIME_MS=900
ARM_STARTUP_J4_RUNTIME_MS=20000
ARM_STARTUP_MAX_SPEED_DEG_S=8
ARM_STARTUP_TIMEOUT_SEC=60

# Fixed tracking envelope observed in the verified raised posture.
# J2=115 is only used for the startup lift; J6 is never commanded.
J1_HARD_MIN=89
J1_HARD_MAX=179
J3_HARD_MIN=75
J3_HARD_MAX=135
J4_HARD_MIN=-30
J4_HARD_MAX=115
J5_HARD_MIN=70
J5_HARD_MAX=110

# Keep the verified envelope unchanged even when the starting angle differs.
# Invalid feedback on one joint does not disable the other safe tracking axes.
J1_LOCAL_SPAN=180
J3_LOCAL_SPAN=180
J4_LOCAL_SPAN=180
J5_LOCAL_SPAN=180

# Face following: J1 pan and J3 tilt; J4 is not commanded.
FACE_TARGET_X=0.50
FACE_TARGET_Y=0.50
FACE_DEADBAND_X=0.035
FACE_DEADBAND_Y=0.035
FACE_GAIN_X=45
FACE_GAIN_Y=45
FACE_PAN_JOINT=1
FACE_PAN_SIGN=1
FACE_TILT_JOINT_A=3
FACE_TILT_SIGN_A=1
FACE_TILT_JOINT_B=4
FACE_TILT_SIGN_B=1
FACE_ROLL_JOINT=5
FACE_ROLL_SIGN=1
FACE_ROLL_DEADBAND_DEG=12
FACE_INTERVAL_SEC=0.07

# UI
SHOW_FACE=1
DISPLAY_NAME=:0
MILO_DISPLAY_ROTATION=left
CAT_GAZE_X_SIGN=-1
CAT_GAZE_Y_SIGN=1
